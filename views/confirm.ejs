<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirm Order</title>
</head>
<body>
    <h1>Thank you for your order, <%= order.fname %>!</h1>
    <h2>Order Summary</h2>
    <p>Name: <%= order.fname%> <%= order.lname %></p>
    <p>Email: <%=order.email%></p>
    <p>Order number: <%=order.id%></p>
    <p><%=order.method %></p>
    <p>Toppings: <%= order.toppings %></p>
    <p>Size: <%= order.size%></p>
    <p>Message: <%= order.comment %></p>
    <p>Time ordered: <%= order.timestamp%></p>
    <a href="/">Home</a>
</body>
</html>